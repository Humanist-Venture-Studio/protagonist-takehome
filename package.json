{
  "name": "protagonist-takehome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "start": "node src/server.ts",
    "check:types": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "build": "npm run check:types",
    "setup": "node scripts/setup.mjs",
    "local": "node scripts/local.mjs start",
    "local:restart": "node scripts/local.mjs restart",
    "local:stop": "node scripts/local.mjs stop",
    "test:linux": "node scripts/local.mjs test",
    "package:candidate": "node scripts/package.mjs"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "parse5": "8.0.1",
    "pdf-lib": "1.17.1",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "7.0.2"
  }
}
